{
  "name": "@bridgecalc/web",
  "version": "1.1.0",
  "description": "Ultralight VanJS + Three.js + WebAssembly 3D continuous bridge HL-93/LM1 moving load analyzer with GeometryMapping",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview --open",
    "test": "node src/__tests__/bridgeWeb.test.ts",
    "build:wasm": "emcc ./src/solver/cpp/bridgeSolver.cpp -o ./src/solver/cpp/built/bridgeSolver.wasm -O3 -s STANDALONE_WASM --no-entry -s EXPORTED_FUNCTIONS=_hl93SimpleSpanMoment,_beamFlexuralStiffness"
  },
  "dependencies": {
    "three": "^0.170.0",
    "vanjs-core": "^1.5.2"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.5"
  }
}
